{
  "name": "testlanes",
  "version": "0.1.0",
  "description": "Runtime-balanced Vitest and Jest shards for GitHub Actions, with timing history collected and reused automatically.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "files": [
    "src/",
    "types/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "DESIGN.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "c8 --reporter=text --reporter=lcov node --test",
    "lint": "npm run lint:code && npm run lint:types && npm run lint:markdown",
    "lint:code": "eslint .",
    "lint:types": "tsc -p tsconfig.json --noEmit",
    "lint:markdown": "eslint --config eslint.config-markdown.js \"*.md\"",
    "types": "node -e \"require('node:fs').rmSync('types',{recursive:true,force:true})\" && tsc -p tsconfig.json --declaration --emitDeclarationOnly --outDir types",
    "prepack": "npm run types",
    "package:check": "node --test test/package.test.js"
  },
  "devDependencies": {
    "@cspell/dict-en_us": "^4.4.43",
    "@cspell/dict-software-terms": "^5.4.11",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "^26.6.11",
    "c8": "^12.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-markdown-preferences": "^0.43.0",
    "eslint-plugin-markdown-preferences-paragraph": "^0.2.0",
    "eslint-plugin-prose-spellcheck": "^0.1.2",
    "globals": "^17.14.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dblock/testlanes.git"
  },
  "bugs": {
    "url": "https://github.com/dblock/testlanes/issues"
  },
  "homepage": "https://github.com/dblock/testlanes#readme",
  "license": "MIT",
  "author": "dblock",
  "keywords": [
    "vitest",
    "jest",
    "github-actions",
    "sharding",
    "parallel",
    "ci"
  ],
  "c8": {
    "include": [
      "src/**/*.js"
    ]
  }
}
